# ---------------------------------------------------------------------------
# Secrets: generated by Terraform, stored in SSM Parameter Store (SecureString),
# read by the instances at boot. Nothing secret is written in Git or in
# user_data (cahier §5.2 "Secrets").
#
# Why SSM Parameter Store and not Secrets Manager: Secrets Manager is not on the
# cahier's §4 list. Parameter Store is free (standard tier) and is the documented
# fallback. Check in the Learner Lab that LabRole can read these parameters.
#
# The generated values also live in the Terraform state: keep the state private
# (S3 bucket with public access blocked, encryption and versioning).
# ---------------------------------------------------------------------------

# No special characters: RDS forbids / @ " and space, and plain text is safe to
# put in a systemd EnvironmentFile.
resource "random_password" "db" {
  length  = 24
  special = false
}

resource "random_password" "jwt" {
  length  = 48
  special = false
}

resource "random_password" "admin" {
  length      = 20
  special     = false
  min_upper   = 1
  min_lower   = 1
  min_numeric = 1
}

resource "aws_ssm_parameter" "db_password" {
  name  = "/${var.name}/db-password"
  type  = "SecureString"
  value = random_password.db.result
}

resource "aws_ssm_parameter" "jwt_secret" {
  name  = "/${var.name}/jwt-secret"
  type  = "SecureString"
  value = random_password.jwt.result
}

resource "aws_ssm_parameter" "admin_password" {
  name  = "/${var.name}/admin-password"
  type  = "SecureString"
  value = random_password.admin.result
}
