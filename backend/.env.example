PORT=3001
NODE_ENV=development

# CORS : URL du frontend
FRONTEND_URL=http://localhost:3000

# PostgreSQL (docker-compose en local, Amazon RDS en production)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gallery
DB_PASSWORD=gallery
DB_NAME=art_gallery
DB_SSL=false

# JWT (en production : AWS Secrets Manager, jamais dans Git)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
