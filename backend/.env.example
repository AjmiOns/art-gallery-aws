PORT=3001
NODE_ENV=development

# CORS : URL du frontend
FRONTEND_URL=http://localhost:3000

# PostgreSQL (docker-compose en local, Amazon RDS en production)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gallery
DB_PASSWORD=gallery
DB_NAME=art_gallery
DB_SSL=false

# JWT (en production : AWS Secrets Manager, jamais dans Git)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Compte administrateur créé au premier démarrage (à changer, surtout en production)
ADMIN_EMAIL=admin@gallery.test
ADMIN_PASSWORD=Admin1234!

# URL publique de l'API (utilisée pour les liens des images envoyées)
PUBLIC_API_URL=http://localhost:3001

# Devise affichée pour les paiements de démonstration
CURRENCY=TND

# Paiement : mock (passerelle de démonstration, aucune configuration)
# ou stripe (mode test gratuit : clé secrète sk_test_... du tableau de bord Stripe)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Stripe ne gère pas le dinar tunisien : le montant est débité dans cette devise en mode test
STRIPE_CURRENCY=eur
